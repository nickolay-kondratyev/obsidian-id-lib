{
	"name": "obsidian-id-lib",
	"version": "0.1.0",
	"description": "Shared doc-id read/ensure for Obsidian plugins (md frontmatter + canvas) with cross-plugin write serialization.",
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"doc-id",
		"frontmatter",
		"canvas"
	],
	"license": "MIT",
	"author": "Nickolay Kondratyev",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/nickolay-kondratyev/obsidian-id-lib.git"
	},
	"bugs": {
		"url": "https://github.com/nickolay-kondratyev/obsidian-id-lib/issues"
	},
	"homepage": "https://github.com/nickolay-kondratyev/obsidian-id-lib#readme",
	"type": "module",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		}
	},
	"sideEffects": false,
	"files": [
		"dist"
	],
	"engines": {
		"node": ">=18"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"clean": "rm -rf dist",
		"build:types": "tsc -p tsconfig.build.json",
		"build:js": "esbuild src/index.ts --bundle --format=esm --platform=neutral --target=es2021 --external:obsidian --outfile=dist/index.js",
		"build": "npm run clean && npm run build:types && npm run build:js",
		"check": "tsc -noEmit",
		"check:e2e": "tsc -noEmit -p e2e/tsconfig.json",
		"check:boundaries": "depcruise src tests --config .dependency-cruiser.cjs",
		"test": "npm run check:boundaries && vitest run",
		"test:domain": "vitest run --project domain",
		"test:watch": "vitest",
		"setup:obsidian": "bash scripts/setup-obsidian-bin.sh",
		"test:e2e": "bash scripts/run-e2e.sh",
		"test:all": "npm run check && npm run check:e2e && npm run test && npm run test:e2e",
		"prepack": "npm run build",
		"prepublishOnly": "npm run check && npm test"
	},
	"peerDependencies": {
		"obsidian": ">=1.5.7"
	},
	"devDependencies": {
		"@cucumber/gherkin": "39.1.0",
		"@cucumber/messages": "32.3.1",
		"@playwright/test": "1.61.1",
		"@types/node": "^26.1.2",
		"dependency-cruiser": "^18.1.1",
		"esbuild": "0.25.5",
		"obsidian": "latest",
		"playwright-bdd": "^9.2.0",
		"quickpickle": "^1.11.2",
		"typescript": "^5.8.3",
		"vitest": "^4.1.10"
	}
}
